{#
    @param {object} event
        @param {int} id
        @param {string} error
#}

{% include "facebook-conversion/_partials/modal" with {
    id: "event-error-" ~ event.id,
    title: "Error"|t('facebook-conversion'),
    content: "<pre class=\"fb-conversion-error-content\">" ~ event.error|e('html') ~ "</pre>"
} only %}

{% css %}
    .fb-conversion-error-content {
        margin: 0;
        max-width: 100%;
        overflow-wrap: break-word;
        white-space: pre-wrap;
        word-break: break-word;
    }
{% endcss %}
