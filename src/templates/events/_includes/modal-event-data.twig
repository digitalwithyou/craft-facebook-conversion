{#
    @param {object} event
        @param {int} id
        @param {string} event_data (JSON)
#}

{# Variables #}

{% set eventData = event.event_data|json_decode(true) %}

{% set eventId = eventData['event_id'] ?? null %}


{# Modal #}

{% include "facebook-conversion/_partials/modal" with {
    id: "event-data-" ~ event.id,
    title: "Event Data"|t('facebook-conversion') ~ " " ~ (eventId ?? null),
    content: include ("facebook-conversion/events/_includes/event-data-table", { data: eventData })
} only %}
