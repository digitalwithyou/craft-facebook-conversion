{#
    @param {array} data
#}

{% if data is iterable and data|length > 0 %}
    <table class="fb-conversion-event-data-table">
        <tbody>
            {% for key, value in data %}
                <tr>
                    <td>{{ key }}</td>
                    <td>
                        {% if value is iterable %}
                            {% include "facebook-conversion/events/_includes/event-data-table" with { data: value } only %}
                        {% else %}
                            {{ value }}
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endif %}

{% css %}
    .fb-conversion-event-data-table td {
        padding-inline-end: 1rem;
        vertical-align: top;
    }
{% endcss %}
