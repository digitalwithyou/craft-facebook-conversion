{#
    @param {array} events
    @param {object} pageInfo
#}

{% import "_includes/forms" as forms %}

{% if events|length > 0 %}
    <div class="tableview">
        <div class="tablepane">
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th>{{ "Event Name"|t('facebook-conversion') }}</th>
                        <th>{{ "Event ID"|t('facebook-conversion') }}</th>
                        <th>{{ "Status"|t('facebook-conversion') }}</th>
                        <th>{{ "Date"|t('facebook-conversion') }}</th>
                        <th>{{ "Data"|t('facebook-conversion') }}</th>
                        <th>{{ "Response"|t('facebook-conversion') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for event in events %}
                        <tr>
                            <td>{{ event.event_name }}</td>
                            <td>{{ event.event_id }}</td>
                            <td>{{ event.status }}</td>
                            <td>{{ event.created_at|date('Y-m-d H:i:s') }}</td>
                            <td>
                                <button type="button" class="btn small" onclick="document.getElementById('event-data-{{ event.id }}').showModal()">
                                    {{ "View Data"|t('facebook-conversion') }}
                                </button>
                            </td>
                            <td>
                                {% if event.response %}
                                    <button type="button" class="btn small" onclick="document.getElementById('event-response-{{ event.id }}').showModal()">
                                        {{ "View Response"|t('facebook-conversion') }}
                                    </button>
                                {% elseif event.error %}
                                    <button type="button" class="btn small" onclick="document.getElementById('event-error-{{ event.id }}').showModal()">
                                        {{ "View Error"|t('facebook-conversion') }}
                                    </button>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="flex flex-justify">
            <div class="fb-conversion-events-pagination light flex-grow">
                {% include "_includes/pagination" with {
                    'pageInfo': pageInfo,
                    'itemLabel' : 'event'|t('facebook-conversion'),
                    'itemsLabel': 'events'|t('facebook-conversion')
                } only %}
            </div>
        </div>

        {% for event in events %}
            {% include "facebook-conversion/events/_includes/modal-event-data" with {
                event: event,
                settings: settings,
            } only %}

            {% if event.response %}
                {% include "facebook-conversion/events/_includes/modal-response" with {
                    event: event,
                } only %}
            {% endif %}

            {% if event.error %}
                {% include "facebook-conversion/events/_includes/modal-error" with {
                    event: event,
                } only %}
            {% endif %}

        {% endfor %}
    </div>

    {% js %}
        document.addEventListener('click', function (e) {
            if (e.target.matches('[data-copy-json-for-graph-explorer]')) {
                var sourceId = e.target.getAttribute('data-copy-source');
                if (sourceId) {
                    var el = document.getElementById(sourceId);
                    if (el && el.value && navigator.clipboard && navigator.clipboard.writeText) {
                        var payload = el.value.replace('__TEXTAREA_CLOSE__', '</textarea>');
                        navigator.clipboard.writeText(payload);
                        var btn = e.target;
                        var originalText = btn.textContent;
                        btn.textContent = btn.getAttribute('data-copied-label') || 'Copied!';
                        setTimeout(function () { btn.textContent = originalText; }, 2000);
                    }
                }
            }
        });
    {% endjs %}
{% else %}

    <h2>{{ "No events found yet"|t('facebook-conversion') }}</h2>

    {% if settings.pixelId is empty or settings.accessToken is empty %}
        <p>{{ "Set your Facebook Pixel ID and Access Token in the <a href='{url}'>plugin settings</a> to get started."|t('facebook-conversion', { url: url('settings/plugins/facebook-conversion') })|raw }}</p>
    {% endif %}

    <p>{{ "Check the documentation to get started."|t('facebook-conversion') }}</p>
    <a href="https://digitalwithyou.com/en/plugins/facebook-conversion/getting-started" target="_blank" class="btn">{{ "Documentation"|t('facebook-conversion') }}</a>

{% endif %}
